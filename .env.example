# Healthfile Environment Template (.env.example)
# Copy this file to .env and adjust values if needed

# Database Connection (Default is zero-config SQLite)
# For PostgreSQL: "postgresql://username:password@localhost:5432/healthfile?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret for authentication
JWT_SECRET="your_strong_random_jwt_secret_here"

# Application URL & Branding
NEXT_PUBLIC_APP_NAME="Healthfile"
NEXT_PUBLIC_APP_TAGLINE="Next-Generation Electronic Health Records & Care Management"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upload storage directory (relative to project root)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="25"
