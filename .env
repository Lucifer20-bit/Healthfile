# Environment Configuration for Healthfile
# No Docker required - runs natively on Node.js

# Database Connection (SQLite local file by default, can be switched to PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Secret for session authentication and token signing
JWT_SECRET="healthfile_super_secure_jwt_secret_key_2026_dev_mode"

# Application URL & Branding
NEXT_PUBLIC_APP_NAME="Healthfile"
NEXT_PUBLIC_APP_TAGLINE="Next-Generation Electronic Health Records & Care Management"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local storage configuration
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="25"
